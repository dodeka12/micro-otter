{
    "python.envFile": "${workspaceFolder}/.env",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff", // the Ruff extension id, installed by the dev container
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit", // run Ruff’s import sorter
            "source.fixAll.ruff": "explicit" // run Ruff’s lint autofixes (covers import order too)
        },
        "editor.formatOnSave": true // required if you want the formatter to run
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "eslint.format.enable": true
}
