# Variables for deploy/docker/compose.yaml and compose.usb.yaml.
# Copy to `.env` next to compose.yaml and edit before `docker compose up`.

# Image tag + wheel version for both images. Unset (commented) keeps the local
# `dev` tag and a `0.0.0` development version; set a released version to pin both:
#   MICRO_OTTER_VERSION=1.43.0

# Host port mapped to the container's 8000.
MICRO_OTTER_PORT=8000

# Feature flags and build tuning surfaced to the compile service. The runtime
# service has no toolchain and ignores these.
MICRO_OTTER_ENABLE_COMPILE=1
MICRO_OTTER_ENABLE_DEPLOY=1
MICRO_OTTER_BUILD_BACKEND=esp-idf
MICRO_OTTER_MAX_BUILD_JOBS=4
MICRO_OTTER_BUILD_TIMEOUT=3600

# Optional: bind-mount the data directory instead of the named `micro-otter-data`
# volume (uncomment and point at a host path):
#   MICRO_OTTER_DATA_DIR=/srv/micro-otter
