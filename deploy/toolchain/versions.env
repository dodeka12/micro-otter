# Shared toolchain pins — canonical source for every host toolchain consumer.
#
# Consumers:
#   deploy/toolchain/esp-idf/bootstrap.sh  (applies these only when a variable is unset)
#   .devcontainer/Dockerfile               (mirrors the values as ENV layer defaults)
#   tests/test_toolchain_scripts.py        (fails when the mirror drifts)
#
# Backend-specific pins belong in deploy/toolchain/<backend>/versions.env. That file is applied
# first, so its values win over this file for that backend only.
ESP_IDF_VERSION=v5.5.2
MICROPYTHON_VERSION=v1.29.0
MPY_CROSS_VERSION=v1.29.0
