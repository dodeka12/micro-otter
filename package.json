{
    "name": "micro-otter-web-tests",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "dev:python": "uv run micro-otter serve",
        "dev:backend": "uv run micro-otter serve",
        "dev:all": "concurrently -k -n web,backend -c cyan,green \"npm:dev:web\" \"npm:dev:backend\"",
        "build": "vite build",
        "preview": "vite preview --host 0.0.0.0",
        "typecheck": "tsc --noEmit",
        "test:node": "npm run test:node:js && npm run test:node:ts",
        "test:node:ts": "node tools/run-node-tests.mjs --mode=ts",
        "test:node:js": "node tools/run-node-tests.mjs --mode=js",
        "test:vitest": "vitest run --passWithNoTests",
        "test:vitest:watch": "vitest",
        "test:browser": "playwright test --pass-with-no-tests",
        "test:browser:headed": "playwright test --headed --pass-with-no-tests",
        "test:all": "npm run check:payload-docs && npm run check:event-payload-emissions && npm run test:node && npm run test:vitest && npm run test:browser",
        "check:ci-local": "npm run check:ci-local:web && npm run check:device-syntax",
        "check:ci-local:web": "npm run check:lockfile-sync && npm run check:oss-generated && npm run check:mdi-generated && npm run check:icons-generated && npm run check:payload-docs && npm run check:event-payload-emissions && npm run lint && npm run lint:python && npm run check:firmware-release && npm run check:docs",
        "check:lockfile-sync": "npm ci --ignore-scripts --dry-run",
        "generate:oss": "node tools/generate-open-source-packages.mjs",
        "check:oss-generated": "npm run generate:oss && git diff --exit-code -- src/micro_otter/nodes/html/js/core/open-source-packages.generated.js",
        "generate:mdi": "node tools/generate-mdi-icons.mjs",
        "check:mdi-generated": "npm run generate:mdi && git diff --exit-code -- src/micro_otter/nodes/html/vendor/mdi",
        "generate:icons": "node tools/generate-inlined-icons.mjs",
        "check:icons-generated": "npm run generate:icons && git diff --exit-code -- src/micro_otter/nodes/html/js/views/icon-data.generated.js",
        "check:payload-docs": "node tools/check-payload-jsdoc.mjs",
        "check:event-payload-emissions": "node tools/check-event-payload-emissions.mjs",
        "check:device-syntax": "uv run python tools/check_device_syntax.py && uv run python tools/check_device_syntax.py --device-root examples/addons",
        "check:firmware-release": "uv run python tools/check_firmware_release.py",
        "check:docs": "uv run mkdocs build --strict",
        "lint:js": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
        "lint:ts": "eslint \"src/**/*.ts\"",
        "lint": "npm run lint:js && npm run lint:ts",
        "format": "prettier --write \"src/**/*.js\"",
        "lint:python": "uv run ruff check src/ tools/ tests/ examples/",
        "lint:python:fix": "uv run ruff check --fix src/ tools/ tests/",
        "format:python": "uv run ruff format src/ tools/ tests/",
        "lint:all": "npm run lint && npm run lint:python && npm run check:device-syntax"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@mdi/svg": "7.4.47",
        "@playwright/test": "^1.58.2",
        "@vitest/coverage-v8": "^3.2.4",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^62.0.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^14.0.0",
        "jsdom": "^27.4.0",
        "playwright": "^1.58.2",
        "prettier": "^3.7.4",
        "terser": "^5.51.2",
        "tsx": "^4.20.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.1",
        "vite-plugin-static-copy": "^3.1.6",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@mdi/font": "7.4.47",
        "marked": "^17.0.1",
        "prismjs": "^1.29.0"
    }
}
