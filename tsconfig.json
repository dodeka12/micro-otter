{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "src/micro_otter/nodes/html/js/**/*",
        "tests/**/*",
        "vite.config.js",
        "vitest.config.js",
        "playwright.config.js"
    ],
    "exclude": [
        "src/micro_otter/nodes/device/**/*",
        "v1/**/*",
        "dist/**/*",
        "node_modules/**/*"
    ]
}