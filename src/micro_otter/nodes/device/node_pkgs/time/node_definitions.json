                    },
                    "description": {
                        "en": "UTC offset in hours (-12 to +14). -100 inherits the timezone of the time-service node (the default).",
                        "de": "UTC-Offset in Stunden (-12 bis +14). -100 erbt die Zeitzone des Zeitdienst-Nodes (Standard)."
                    },
                    "allowedTypes": [
                        "float"
                    ],
                    "initialTypes": [
                        "float"
                    ],
                    "phase": "loop",
                    "defaultControl": {
                        "type": "number",
