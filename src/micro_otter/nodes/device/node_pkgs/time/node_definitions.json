                        "de": "Die formatierte Ortszeit."
                    },
                    "outputType": "string",
                    "initialTypes": [
                        "string"
                    ],
                    "phase": "loop"
                }
            ],
            "controls": [
                {
                    "type": "text",
                    "id": "pattern",
                    "label": {
                        "en": "Pattern",
