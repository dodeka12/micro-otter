{
    "nodeTypes": {
        "mqtt-read": {
            "title": {
                "en": "MQTT Read",
                "de": "MQTT lesen"
            },
            "info": {
                "en": "Reads the latest value from a subscribed MQTT topic.",
                "de": "Liest den letzten Wert eines abonnierten MQTT-Topics."
            },
            "category": "mqtt",
            "color": "#4a6fa5",
            "shape": "square",
            "icon": "icons/cloud_download_24dp.svg",
            "inputs": [
                {
                    "id": "default",
                    "name": {
                        "en": "Default",
                        "de": "Standard"
                    },
                    "description": {
                        "en": "Value emitted while no usable message is available.",
                        "de": "Wert, der ausgegeben wird, solange keine nutzbare Nachricht vorliegt."
                    },
                    "allowedTypes": [
                        "float",
                        "int",
                        "bool",
                        "string"
                    ],
                    "defaultControl": {
                        "type": "number",
                        "label": {
                            "en": "Default",
                            "de": "Standard"
                        },
                        "min": -100000,
                        "max": 100000,
                        "step": 0.01,
                        "default": 0
                    }
                }
            ],
            "outputs": [
                {
                    "id": "value",
                    "name": {
                        "en": "Value",
                        "de": "Wert"
                    },
                    "description": {
                        "en": "Latest value received from the topic.",
                        "de": "Zuletzt vom Topic empfangener Wert."
                    },
                    "outputType": "string",
                    "initialTypes": [
                        "float",
                        "int",
                        "bool",
                        "string"
                    ],
                    "outputTypeControl": "valueType",
                    "outputTypeByControlValue": {
                        "float": "float",
                        "int": "int",
                        "bool": "bool",
                        "string": "string"
                    }
                },
                {
                    "id": "updated",
                    "name": {
                        "en": "Updated",
                        "de": "Aktualisiert"
                    },
                    "description": {
                        "en": "True when a new usable message arrived this cycle.",
                        "de": "True, wenn in diesem Zyklus eine neue nutzbare Nachricht ankam."
                    },
                    "outputType": "bool",
                    "initialTypes": [
                        "bool"
                    ]
                }
            ],
            "controls": [
                {
                    "type": "dropdown",
                    "id": "topic",
                    "label": {
                        "en": "Topic",
                        "de": "Topic"
                    },
                    "description": {
                        "en": "Topic already used in this graph, or create a new one.",
                        "de": "Bereits im Graphen verwendetes Topic oder ein neues anlegen."
                    },
                    "required": true,
                    "affectsControls": true,
                    "default": "",
                    "dynamicOptions": {
                        "source": "graphTopics",
                        "newTopicControls": [
                            "customTopic"
                        ]
                    }
                },
                {
                    "type": "text",
                    "id": "customTopic",
                    "label": {
                        "en": "New topic",
                        "de": "Neues Topic"
                    },
                    "description": {
                        "en": "Full topic path to read from, e.g. home/sensor/temperature.",
                        "de": "Vollständiger Topic-Pfad, z. B. home/sensor/temperature."
                    },
                    "default": ""
                },
                {
                    "type": "dropdown",
                    "id": "payloadMode",
                    "label": {
                        "en": "Payload Mode",
                        "de": "Nutzlastmodus"
                    },
                    "description": {
                        "en": "Single value or one JSON object written into a variable store.",
                        "de": "Einzelwert oder ein JSON-Objekt, das in einen Variablenspeicher geschrieben wird."
                    },
                    "default": "value",
                    "affectsControls": true,
                    "options": [
                        {
                            "value": "value",
                            "label": {
                                "en": "Single value",
                                "de": "Einzelwert"
                            },
                            "activeControls": [
                                "valueType",
                                "jsonKey"
                            ]
                        },
                        {
                            "value": "json-store",
                            "label": {
                                "en": "JSON to store",
                                "de": "JSON in Speicher"
                            },
                            "activeControls": [
                                "storeNamespace"
                            ]
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "storeNamespace",
                    "label": {
                        "en": "Store",
                        "de": "Speicher"
                    },
                    "description": {
                        "en": "Variables namespace that receives one entry per JSON key. Keys are created as needed.",
                        "de": "Variablen-Namespace, der pro JSON-Schlüssel einen Eintrag erhält. Schlüssel werden bei Bedarf angelegt."
                    },
                    "default": ""
                },
                {
                    "type": "dropdown",
                    "id": "qos",
                    "label": {
                        "en": "QoS",
                        "de": "QoS"
                    },
                    "description": {
                        "en": "Subscription quality of service.",
                        "de": "Quality of Service des Abonnements."
                    },
                    "default": 0,
                    "options": [
                        {
                            "value": 0,
                            "label": {
                                "en": "0 — At most once",
                                "de": "0 — höchstens einmal"
                            }
                        },
                        {
                            "value": 1,
                            "label": {
                                "en": "1 — At least once",
                                "de": "1 — mindestens einmal"
                            }
                        }
                    ]
                },
                {
                    "type": "dropdown",
                    "id": "valueType",
                    "label": {
                        "en": "Value Type",
                        "de": "Werttyp"
                    },
                    "description": {
                        "en": "How the incoming payload is interpreted.",
                        "de": "Wie die eingehende Nutzlast interpretiert wird."
                    },
                    "default": "string",
                    "options": [
                        {
                            "value": "string",
                            "label": {
                                "en": "String",
                                "de": "Text"
                            }
                        },
                        {
                            "value": "float",
                            "label": {
                                "en": "Float",
                                "de": "Fließkomma"
                            }
                        },
                        {
                            "value": "int",
                            "label": {
                                "en": "Int",
                                "de": "Ganzzahl"
                            }
                        },
                        {
                            "value": "bool",
                            "label": {
                                "en": "Bool",
                                "de": "Boolesch"
                            }
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "jsonKey",
                    "label": {
                        "en": "JSON Key",
                        "de": "JSON-Schlüssel"
                    },
                    "description": {
                        "en": "Optional key to extract from a JSON payload.",
                        "de": "Optionaler Schlüssel, der aus einer JSON-Nutzlast extrahiert wird."
                    },
                    "default": ""
                },
                {
                    "type": "checkbox",
                    "id": "defaultWhenDisconnected",
                    "label": {
                        "en": "Default on Dis.",
                        "de": "Standard bei Trennung"
                    },
                    "description": {
                        "en": "Emit the default value whenever no usable message arrived since the current connection was established.",
                        "de": "Den Standardwert ausgeben, solange seit dem aktuellen Verbindungsaufbau keine nutzbare Nachricht ankam."
                    },
                    "default": false
                }
            ],
            "initImplementations": {
                "python": {
                    "type": "code-generator",
                    "value": "NodeInitGenerators.mqttRead"
                }
            },
            "implementations": {
                "python": {
                    "type": "code-generator",
                    "value": "NodeCodeGenerators.mqttRead"
                }
            },
            "initFunction": "init_mqtt"
        },
