            "outputs": [],
            "controls": [
                {
                    "type": "dropdown",
                    "id": "pin",
                    "label": {
                        "en": "Data Pin",
                        "de": "Daten-Pin"
                    },
                    "default": 2,
                    "dynamicOptions": {
                        "source": "targetPinsForCapability",
                        "capabilityKey": "digital.output"
                    },
                    "description": {
                        "en": "Data pin driving the strip.",
                        "de": "Daten-Pin, der den Streifen ansteuert."
                    }
                },
                {
                    "type": "number",
                    "id": "count",
                    "label": {
                        "en": "Count",
                        "de": "Anzahl"
                    },
                    "min": 1,
                    "max": 4096,
                    "step": 1,
                    "default": 60,
                    "description": {
                        "en": "Number of LEDs in the strip. Count must match the physical LED count; array values beyond Count are truncated and missing values stay dark.",
                        "de": "Anzahl der LEDs im Streifen. Anzahl muss der tatsächlichen LED-Anzahl entsprechen; Array-Werte über Anzahl hinaus werden abgeschnitten und fehlende Werte bleiben dunkel."
                    }
