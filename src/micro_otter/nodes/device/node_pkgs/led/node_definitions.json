                {
                    "type": "dropdown",
                    "id": "order",
                    "label": {
                        "en": "Color Order",
                        "de": "Farbreihenfolge"
                    },
                    "default": "GRB",
                    "options": [
                        {
                            "value": "GRB",
                            "label": {
                                "en": "GRB",
                                "de": "GRB"
                            }
                        },
                        {
                            "value": "RGB",
                            "label": {
                                "en": "RGB",
                                "de": "RGB"
                            }
                        },
                        {
                            "value": "BRG",
                            "label": {
                                "en": "BRG",
                                "de": "BRG"
                            }
                        },
                        {
                            "value": "RBG",
                            "label": {
                                "en": "RBG",
                                "de": "RBG"
                            }
                        },
                        {
                            "value": "GBR",
                            "label": {
                                "en": "GBR",
                                "de": "GBR"
                            }
                        },
                        {
                            "value": "BGR",
                            "label": {
                                "en": "BGR",
                                "de": "BGR"
                            }
                        }
                    ],
                    "description": {
                        "en": "Color order of the strip protocol. For Color Model = RGBW the white byte (W) is appended automatically as the fourth byte.",
                        "de": "Farbreihenfolge des Streifenprotokolls. Bei Farbmodell = RGBW wird das Weiß-Byte (W) automatisch als viertes Byte angehängt."
                    }
                },
                {
                    "type": "dropdown",
                    "id": "colorModel",
                    "label": {
                        "en": "Color Model",
                        "de": "Farbmodell"
                    },
                    "default": "rgb",
                    "options": [
                        {
                            "value": "single",
                            "label": {
                                "en": "Single color",
                                "de": "Einzeln"
                            }
                        },
                        {
                            "value": "rgb",
                            "label": {
                                "en": "RGB",
                                "de": "RGB"
                            }
                        },
                        {
                            "value": "rgbw",
                            "label": {
                                "en": "RGBW",
                                "de": "RGBW"
                            }
                        }
                    ],
                    "description": {
                        "en": "How channel values are interpreted: Single color uses Channel 0 for all three color bytes (a scalar or an array of length Count); RGB uses Channels 0–2; RGBW uses Channels 0–3.",
                        "de": "Wie Kanalwerte interpretiert werden: Einzeln verwendet Kanal 0 für alle drei Farbbytes (Skalar oder Array der Länge Anzahl); RGB verwendet Kanäle 0–2; RGBW verwendet Kanäle 0–3."
                    }
                }
            ],
            "resourceUsage": [
